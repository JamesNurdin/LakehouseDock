    "\n",
    "SCHEMA = \"tpcds\"\n",
    "CATALOG = \"iceberg\"\n",
    "\n",
    "NUM_QUERIES = 1000\n",
    "\n",
    "MODEL_NAME_OVERRIDE = MODEL_NAME\n",
    "BASE_URL = BASE_MODEL_URL\n",
    "API_KEY_ENV_NAME = API_KEY_ENV\n",
    "\n",

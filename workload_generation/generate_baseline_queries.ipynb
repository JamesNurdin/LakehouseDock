    "BASE_URL = \"https://router.huggingface.co/v1\"\n",
    "API_KEY_ENV_NAME = \"HF_TOKEN\"\n",
    "\n",
    "TEMPERATURE = 0.6\n",
    "REASONING = \"high\"\n",
    "\n",
    "RANDOM_SEED = 42\n",
    "WARMUP = True\n",
